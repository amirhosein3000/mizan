# Mizan — environment variables. Copy to .env.local (dev) or set in your host (Liara/Docker).
# With nothing set, the app runs fully in MOCK mode: mock prices + canned assistant answers.

# ---------------------------------------------------------------------------
# LLM (any OpenAI-compatible endpoint: /chat/completions and /audio/transcriptions)
# ---------------------------------------------------------------------------
# true = never call an LLM; canned answers and mock vision (also the default when LLM_API_KEY is empty)
MOCK_LLM=true
# e.g. https://api.openai.com/v1 , https://api.avalai.ir/v1 , https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=
LLM_API_KEY=
# Text model for chat
LLM_MODEL=gpt-4o-mini
# Model that accepts images (photo identify + Price X-ray). Defaults to LLM_MODEL.
VISION_MODEL=gpt-4o-mini
# Speech-to-text model (voice input module). Defaults to whisper-1.
STT_MODEL=whisper-1
# Set to false if the provider rejects response_format=json_object
LLM_JSON_MODE=true
# Per-request timeout in ms
LLM_TIMEOUT_MS=25000

# Optional backup provider, used automatically when the primary times out / is down / rejects the key.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_VISION_MODEL=
LLM_FALLBACK_STT_MODEL=

# ---------------------------------------------------------------------------
# Price data
# ---------------------------------------------------------------------------
# mock | torob   (torob is a stub until the sponsor gives us data/API — see docs/spec-day.md)
PRICE_PROVIDER=mock
TOROB_API_BASE_URL=
TOROB_API_KEY=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite file. In Docker/Liara mount a persistent disk at /app/data.
DATABASE_PATH=./data/mizan.db

# ---------------------------------------------------------------------------
# Feature flags (BUILD-TIME, comma-separated module ids — see src/config/features.ts)
# ---------------------------------------------------------------------------
# e.g. NEXT_PUBLIC_FEATURES_OFF=chat,savings
NEXT_PUBLIC_FEATURES_OFF=
NEXT_PUBLIC_FEATURES_ON=
